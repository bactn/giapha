{
  "name": "giapha_online",
  "version": "1.0.0",
  "description": "Nền tảng Quản lý & Trực quan hoá Cây Gia Phả Dòng Họ - Hỗ trợ Import Excel & Giao diện Kéo Thả MindNode",
  "main": "server.js",
  "scripts": {
    "check:supabase": "node scripts/check-supabase.cjs",
    "test:supabase": "node --experimental-default-type=module --test tests/supabase-config.test.cjs tests/validate-lineage.test.cjs tests/supabase-services.test.mjs",
    "validate:lineage": "node scripts/validate-lineage.cjs",
    "build:pages": "node scripts/build-pages.cjs",
    "build:pages:docs": "node scripts/build-pages.cjs --docs",
    "start": "node scripts/serve.cjs",
    "dev": "node scripts/serve.cjs",
    "be": "node server.js",
    "generate-excel": "python3 generate_excel.py",
    "test:export": "node --experimental-default-type=module --test tests/export-layout.test.mjs"
  },
  "keywords": [
    "genealogy",
    "family-tree",
    "gia-pha",
    "mindnode",
    "excel-import",
    "vietnam"
  ],
  "author": "Antigravity Team",
  "license": "ISC",
  "engines": { "node": ">=22" },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
